# MailSalon configuration
# Default Linux location: ~/.config/mailsalon/config.toml
# Quickstart: docs/quickstart.md. Reference: docs/configuration.md.
# Replace the identity, Maildir and sync account name before use.
# Transport credentials belong in your sync/sending tool configuration.
#
# Each [[accounts]] block is independent. MailSalon reads that account's
# Maildir and uses that account's receive/send commands, identity, signature,
# and optional OpenPGP settings.

[[accounts]]
name = "personal"
maildir = "~/Maildir"
from = "Your Name <you@example.com>"
# signature_file = "~/.signature"  # Optional; create the file before enabling.
trash_folder = "Trash"
# Matches a plain Archive Maildir or Maildir++ .Archive; no server role is required.
archive_folder = "Archive"
download_dir = "~/Downloads"
receive = "MailSalonSync -plain sync"
send = "MailSalonSync -plain jmap-send -account personal-jmap"

# Optional OpenPGP/GnuPG support for this account. `command` is an executable
# name or path, not an arbitrary shell command. Point it at a wrapper script if
# you need custom GnuPG invocation behavior.
# [accounts.gpg]
# enabled = true
# command = "gpg"
# homedir = "~/.gnupg"
# sign_key = "you@example.com"
# auto_sign = false
# auto_encrypt = false
# encrypt_to_self = true

# Example second account:
# [[accounts]]
# name = "work"
# maildir = "~/Maildir-work"
# from = "Your Name <you@work.example>"
# signature_file = "~/.signature-work"
# trash_folder = "Trash"
# archive_folder = "Archive"
# download_dir = "~/Downloads"
# receive = "mbsync work"
# send = "msmtp -a work -t"
#
# [accounts.gpg]
# enabled = true
# command = "gpg"
# sign_key = "you@work.example"
# auto_sign = true
# auto_encrypt = false
# encrypt_to_self = true

[options]
default_account = "personal"
startup_sync = false
# Opening a reply saves missing senders to an account contact book or shared fallback.
# Set false to disable reply saving; contact autocomplete still works.
auto_add_reply_contacts = true
# Periodic background sync. Go duration syntax is supported: 30s, 5m, 1h.
# Set to "0" to disable automatic periodic syncing.
sync_interval = "5m"


# Optional keybindings. These are the defaults; omit any entry you do not want
# to change. The on-screen legends use the configured values automatically.
[keybindings]
mail_view = "1"
contacts_view = "2"
calendar_view = "3"
quit = "q"
compose = "c"
sync = "u"
reply = "r"
forward = "f"
archive = "e"
toggle_read = "m"
search = "/"
delete = "d"
save_attachments = "a"
switch_account = "A"
refresh = "R"
focus_next = "Tab"
focus_left = "h"
focus_right = "l"
move_up = "k"
move_down = "j"
page_up = "PgUp"
page_down = "PgDn"
home = "Home"
end = "End"
open = "Enter"
send = "Ctrl+S"
attach = "Ctrl+A"
pgp_mode = "Ctrl+G"
cancel = "Esc"
next_field = "Tab"
previous_field = "Shift+Tab"

# Optional UI theme. Colors may be #RRGGBB truecolor values or supported
# color names. Omitted theme values fall back to MailSalon's defaults.
[theme]
background = "#090d16"
foreground = "#d8dee9"
muted = "#77839a"
border = "#36506b"
active_border = "#64d8cb"
title = "#ff9ecb"
selected_fg = "#071018"
selected_bg = "#ff9ecb"
account = "#d9a7ff"
unread = "#f6c177"
status = "#64d8cb"
error = "#ff6b81"
cursor_fg = "#071018"
cursor_bg = "#ff9ecb"

# Optional contacts/calendars. These paths must match MailSalonSync collections.
# See docs/contacts-calendar.md. Set account to the matching [[accounts]] name.
# Omit account only for collections intentionally shared across accounts.
# [[collections]]
# name = "Personal contacts"
# account = "personal"
# protocol = "carddav"
# local_dir = "~/PIM/contacts/personal"
#
# [[collections]]
# name = "Personal calendar"
# account = "personal"
# protocol = "caldav"
# local_dir = "~/PIM/calendars/personal"
#
# JMAP directories use protocol = "jmap-contacts" or "jmap-calendars".

