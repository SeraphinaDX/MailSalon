# MailSalon configuration
# Default location: ~/.config/mailsalon/config.toml
#
# Each [[accounts]] block is independent. MailSalon reads that account's
# Maildir and uses that account's receive/send commands, identity, signature,
# and optional OpenPGP settings.

[[accounts]]
name = "cerberus"
maildir = "~/Maildir"
from = "Britney Lozza <britney@cerberusgames.ca>"
signature_file = "~/.signature"
trash_folder = "Trash"
# Matches a plain Archive Maildir or Maildir++ .Archive; no server role is required.
archive_folder = "Archive"
download_dir = "~/Downloads"
receive = "MailSalonSync -plain sync"
send = "MailSalonSync -plain jmap-send -account cerberus-jmap"

# Optional OpenPGP/GnuPG support for this account. `command` is an executable
# name or path, not an arbitrary shell command. Point it at a wrapper script if
# you need custom GnuPG invocation behavior.
[accounts.gpg]
enabled = true
command = "gpg"
# homedir = "~/.gnupg"
sign_key = "britney@cerberusgames.ca"
auto_sign = false
auto_encrypt = false
encrypt_to_self = true

# Example second account:
# [[accounts]]
# name = "work"
# maildir = "~/Maildir-work"
# from = "Your Name <you@work.example>"
# signature_file = "~/.signature-work"
# trash_folder = "Trash"
# archive_folder = "Archive"
# download_dir = "~/Downloads"
# receive = "mbsync work"
# send = "msmtp -a work -t"
#
# [accounts.gpg]
# enabled = true
# command = "gpg"
# sign_key = "you@work.example"
# auto_sign = true
# auto_encrypt = false
# encrypt_to_self = true

[options]
default_account = "cerberus"
startup_sync = false


# Optional keybindings. These are the defaults; omit any entry you do not want
# to change. The on-screen legends use the configured values automatically.
[keybindings]
quit = "q"
compose = "c"
sync = "u"
reply = "r"
forward = "f"
archive = "e"
toggle_read = "m"
search = "/"
delete = "d"
save_attachments = "a"
switch_account = "A"
refresh = "R"
focus_next = "Tab"
focus_left = "h"
focus_right = "l"
move_up = "k"
move_down = "j"
page_up = "PgUp"
page_down = "PgDn"
home = "Home"
end = "End"
open = "Enter"
send = "Ctrl+S"
attach = "Ctrl+A"
pgp_mode = "Ctrl+G"
cancel = "Esc"
next_field = "Tab"
previous_field = "Shift+Tab"

# Optional UI theme. Colors may be #RRGGBB truecolor values or supported
# color names. Omitted theme values fall back to MailSalon's defaults.
[theme]
background = "#090d16"
foreground = "#d8dee9"
muted = "#77839a"
border = "#36506b"
active_border = "#64d8cb"
title = "#ff9ecb"
selected_fg = "#071018"
selected_bg = "#ff9ecb"
account = "#d9a7ff"
unread = "#f6c177"
status = "#64d8cb"
error = "#ff6b81"
cursor_fg = "#071018"
cursor_bg = "#ff9ecb"
